# 复制本文件为 .env，再修改成你自己的值。docker compose 会自动读取 .env。
# 数据库名（应用和 MySQL 容器共用）
DB_NAME=taskflow
# MySQL root 密码（生产环境务必改成强密码）
DB_PASSWORD=change-me-strong-password
# JWT 密钥，至少 32 字节，生产环境改成随机长字符串
JWT_SECRET=please-change-this-to-a-long-random-string-at-least-32-bytes
# access token 过期时间，单位毫秒，默认 30 分钟
JWT_ACCESS_EXPIRATION=1800000
# refresh token 过期时间，单位毫秒，默认 7 天
JWT_REFRESH_EXPIRATION=604800000
